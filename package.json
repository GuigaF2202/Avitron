  {
  "name": "avitron-metaverse",
  "version": "1.0.0",
  "description": "Plataforma Avitron Metaverse - Sistema de Registro e Autenticação",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently --names \"backend,frontend\" --prefix-colors \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "start:backend": "cd backend && npm start",
    "start:prod": "concurrently --kill-others-on-fail \"npm run build\" \"npm run start:backend\"",
    "setup-db": "cd backend && npm run setup-db",
    "lint": "cd frontend && npm run lint",
    "build:lint": "concurrently \"npm run lint\" \"npm run build\"",
    "pm2:setup": "pm2 install pm2-logrotate",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "deploy": "npm run build && npm run pm2:start",
    "pm2:stop-all": "pm2 stop all",
    "pm2:delete-all": "pm2 delete all",
    "pm2:clean": "pm2 stop all && pm2 delete all",
    "pm2:reload": "npm run pm2:clean && npm run pm2:start",
    "pm2:dev": "pm2 start ecosystem.dev.config.js",
    "pm2:dev:stop": "pm2 stop ecosystem.dev.config.js",
    "pm2:dev:restart": "pm2 restart ecosystem.dev.config.js",
    "pm2:dev:delete": "pm2 delete ecosystem.dev.config.js",
    "pm2:dev:logs": "pm2 logs"
  },
  "keywords": [
    "metaverse",
    "avitron",
    "opensim",
    "realidade virtual"
  ],
  "author": "Luiz Guilherme",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pm2": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}